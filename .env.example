# Copy this file to .env and fill in real values. Never commit .env.

# --- Claude / Anthropic ---
ANTHROPIC_API_KEY=

# --- Broker API (Zerodha Kite / Upstox / Fyers) ---
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCESS_TOKEN=

# --- Market data / news providers ---
ALPHA_VANTAGE_API_KEY=
NEWSAPI_KEY=
FINNHUB_API_KEY=

# --- Telegram (primary action channel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord (secondary organized reading/logging surface) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_MARKET_NEWS=
DISCORD_CHANNEL_SIGNALS=
DISCORD_CHANNEL_MONITORING=
DISCORD_CHANNEL_CHAT=
DISCORD_CHANNEL_CLOSED_TRADES=
# Phase 15: Option Trading advisories, position updates, watch-mode
# escalations, and confirmed false breakouts.
DISCORD_CHANNEL_OPTION_TRADING=

# --- Ollama (local model for filtering/extraction/formatting) ---
OLLAMA_HOST=
OLLAMA_MODEL=

# --- Storage ---
SQLITE_DB_PATH=

# --- Logging (defaults to INFO if unset) ---
LOG_LEVEL=

# --- Analysis defaults ---
DEFAULT_TIMEFRAME=
WATCHLIST=

# --- Phase 14 Task 4: gated risk-regime bias for shortlist ranking ---
# Strategy-logic change, defaults to False/unset. Do not enable without
# reviewing skills/signal_skill.py's shortlist() ranking behavior first.
ENABLE_RISK_REGIME_BIAS=

# --- Phase 15: Option Trading (NIFTY Options Engine) ---
# Angel One SmartAPI is the options data source — DATA ONLY, no order
# placement. Supports unattended login (client code + PIN + TOTP) so the
# engine can log in on cron with no human in the loop. Never commit real
# values.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
# Local files (outside the repo) caching the day's session tokens / the
# instrument master. Defaults shown — see config/options_config.py.
ANGEL_TOKEN_CACHE_PATH=
ANGEL_INSTRUMENTS_CACHE_PATH=
# How many strikes above/below ATM to request per fetch cycle (Angel's
# getMarketData is token-based, max 50 tokens/call).
ANGEL_ATM_STRIKE_WINDOW=

# All OPTIONS_* thresholds below are optional — each defaults to the value
# in config/options_config.py's OptionsConfig. Set only what you want to
# override; see options_config.py for the full list and defaults.
OPTIONS_PROXIMITY_THRESHOLD_PCT=
OPTIONS_PROXIMITY_MODE=
OPTIONS_ATR_MULTIPLIER=
OPTIONS_DEESCALATE_THRESHOLD_PCT=
OPTIONS_ZONE_MERGE_THRESHOLD_PCT=
OPTIONS_SUSTAIN_MINUTES=
OPTIONS_WATCH_TIMEOUT_MINUTES=
OPTIONS_VOLUME_CONFIRM_MULTIPLIER=
OPTIONS_BOUNDARY_MIN_SHARE=
OPTIONS_STRIKE_WINDOW_PRIMARY=
OPTIONS_STRIKE_WINDOW_EXTENDED=
OPTIONS_NEXT_LEVEL_MIN_SHARE=
OPTIONS_GREEKS_CROSSCHECK_ENABLED=
OPTIONS_CLASSIFICATION_MIN_MOVE_PCT=
OPTIONS_RISK_FREE_RATE=
OPTIONS_GREEKS_DIVERGENCE_THRESHOLD=
OPTIONS_PREMIUM_CONFIRM_SUSTAIN_COUNT=
# Scoring weights (rulebook Section 43) — must sum to 100.
OPTIONS_MIN_SCORE=
OPTIONS_SCORE_WEIGHT_TREND_PA=
OPTIONS_SCORE_WEIGHT_CONFIRMATION=
OPTIONS_SCORE_WEIGHT_OI_STRUCTURE=
OPTIONS_SCORE_WEIGHT_DELTA_OI=
OPTIONS_SCORE_WEIGHT_VOLUME=
OPTIONS_SCORE_WEIGHT_RR=
OPTIONS_SCORE_WEIGHT_IV_GREEKS=
OPTIONS_SCORE_WEIGHT_PCR=
OPTIONS_SCORE_WEIGHT_LIQUIDITY=
OPTIONS_MIN_RR=
OPTIONS_CAPITAL=
OPTIONS_RISK_PCT=
OPTIONS_DELTA_BAND_MIN=
OPTIONS_DELTA_BAND_MAX=
OPTIONS_MAX_SPREAD_PCT=
OPTIONS_MIN_OI=
OPTIONS_MIN_VOLUME=
OPTIONS_HOLDING_FIT_MULTIPLIER=
OPTIONS_THETA_DANGER_DAYS=
OPTIONS_IV_EVENT_CALENDAR_PATH=
OPTIONS_ENTRY_ZONE_BUFFER_PCT=
OPTIONS_INVALIDATION_BUFFER_PCT=
OPTIONS_MIN_OPTION_PREMIUM=
OPTIONS_TARGET_SPLIT_RATIO=
OPTIONS_SNAPSHOT_RETENTION_DAYS=
OPTIONS_DATA_STALENESS_SECONDS=
OPTIONS_SPOT_DIVERGENCE_THRESHOLD_PCT=
