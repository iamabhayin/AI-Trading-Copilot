# Copy this file to .env and fill in real values. Never commit .env.

# --- Claude / Anthropic ---
ANTHROPIC_API_KEY=

# --- Broker API (Zerodha Kite / Upstox / Fyers) ---
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCESS_TOKEN=

# --- Market data / news providers ---
ALPHA_VANTAGE_API_KEY=
NEWSAPI_KEY=
FINNHUB_API_KEY=

# --- Telegram (primary action channel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord (secondary organized reading/logging surface) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_MARKET_NEWS=
DISCORD_CHANNEL_SIGNALS=
DISCORD_CHANNEL_MONITORING=
DISCORD_CHANNEL_CHAT=
DISCORD_CHANNEL_CLOSED_TRADES=

# --- Ollama (local model for filtering/extraction/formatting) ---
OLLAMA_HOST=
OLLAMA_MODEL=

# --- Storage ---
SQLITE_DB_PATH=

# --- Logging (defaults to INFO if unset) ---
LOG_LEVEL=

# --- Analysis defaults ---
DEFAULT_TIMEFRAME=
WATCHLIST=
